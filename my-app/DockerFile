# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable && corepack prepare yarn@4.14.1 --activate

FROM base AS deps
COPY package.json yarn.lock .yarnrc.yml ./
COPY backend/package.json ./backend/package.json
COPY my-app/package.json ./my-app/package.json
RUN yarn install --immutable

FROM deps AS build
COPY . .
RUN yarn workspace my-app build

# Static files served by nginx. The unprivileged image runs as non-root on port 8080.
FROM nginxinc/nginx-unprivileged:1.29-alpine AS runtime
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/my-app/dist /usr/share/nginx/html

EXPOSE 8080